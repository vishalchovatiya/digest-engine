# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# Required: Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: Verified sender address in Resend
# Format: "Display Name <address@yourdomain.com>" or plain "address@yourdomain.com"
DIGEST_FROM_EMAIL=Digest <digest@updates.example.com>

# Optional: default recipients when a digest's `email.to` list is empty.
# Comma-separated; whitespace around each address is trimmed and blanks are ignored.
# Example: DIGEST_TO_EMAILS="a@example.com,b@example.com, c@example.com"
DIGEST_TO_EMAILS=you@example.com
