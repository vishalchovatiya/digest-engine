{
  "name": "digest-engine",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {},
  "postCreateCommand": "pip install --user -r requirements.txt",
  "postAttachCommand": "python scripts/generate_workflows.py --check || true",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "data/state.db": true,
          "data/rendered": true
        }
      }
    }
  }
}

